+def _decision_error(instruction, candidate):
+    """Return a compact legality error for the current observed stage, if any."""
+    match = re.search(r"## Current stage state\s*```json\s*(.*?)\s*```", instruction, re.DOTALL)
+    if not match:
+        return None
+    try:
+        state = json.loads(match.group(1))
+        decision = json.loads(candidate)
+    except (TypeError, ValueError, json.JSONDecodeError):
+        return "Return exactly one valid JSON decision object, with no commentary."
+    if not isinstance(state, dict) or not isinstance(decision, dict):
+        return "Return exactly one JSON object matching the requested decision schema."
+    if decision.get("task_id") != state.get("task_id") or decision.get("stage_id") != state.get("stage_id"):
+        return "Use the task_id and stage_id from the current observation exactly."
+    if state.get("decision_type") == "combat":
+        hands = {d["turn"]: Counter(d.get("hand", [])) for d in state["combat"].get("draws", [])}
+        energy = state["player_state"].get("energy_per_turn", 0)
+        seen_turns = set()
+        for row in decision.get("turns", []):
+            turn = row.get("turn")
+            if turn in seen_turns:
+                return "Combat turn numbers must be unique."
+            seen_turns.add(turn)
+            if not isinstance(turn, int) or turn not in hands:
+                return "Every combat turn must be a unique in-range turn in the supplied draws."
+            plays = row.get("play", [])
+            if not isinstance(plays, list):
+                return f"Turn {turn} play must be a list of card IDs."
+            used = Counter(plays)
+            if used - hands[turn]:
+                return f"Turn {turn} uses cards not available in that exact hand; remove or replace them."
+            catalog = state.get("card_catalog", {})
+            cost = sum(catalog.get(card, {}).get("cost", 10) * count for card, count in used.items())
+            if cost > energy:
+                return f"Turn {turn} exceeds the available energy; reduce its plays."
+    elif state.get("decision_type") == "shop":
+        offers = set(state.get("shop", {}).get("offers", []))
+        buys = decision.get("buy_cards", [])
+        if len(buys) != len(set(buys)) or any(card not in offers for card in buys):
+            return "Buy only distinct card IDs listed in the current shop offers."
+    return None
+
 class TaskAgent(AgentSystem):
     def act(self, prompt, image_paths=None, max_tokens=16384):
         """Expose the common Agent interface while retaining ``forward``."""
