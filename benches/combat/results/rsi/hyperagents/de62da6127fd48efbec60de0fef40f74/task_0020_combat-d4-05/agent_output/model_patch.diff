+import json
+import re
+
 from agent.base_agent import AgentSystem
 from agent.llm_withtools import chat_with_agent
 
+
+def _validate_combat_response(text, instruction):
+    """Catch hand/cost mistakes locally so the model gets a bounded repair pass."""
+    if '"decision_type": "combat"' not in instruction:
+        return None
+    try:
+        decision = json.loads(text.strip().strip('`'))
+        match = re.search(r"```json\s*(\{.*\})\s*```", instruction, re.S)
+        if not match:
+            return "current observation could not be parsed"
+        state = json.loads(match.group(1))
+        draws = {d["turn"]: list(d["hand"]) for d in state["combat"]["draws"]}
+        catalog = state["card_catalog"]
+        energy = state["player_state"]["energy_per_turn"]
+        seen = set()
+        for row in decision.get("turns", []):
+            turn, play = row["turn"], row.get("play", [])
+            if turn in seen:
+                return f"turn {turn} is duplicated"
+            seen.add(turn)
+            if turn not in draws:
+                return f"turn {turn} is outside the supplied draws"
+            hand = draws[turn]
+            for card in play:
+                if card not in hand:
+                    return f"turn {turn}: {card} is not in that exact hand"
+                hand.remove(card)
+            cost = sum(catalog[card]["cost"] for card in play)
+            if cost > energy:
+                return f"turn {turn}: cost {cost} exceeds energy {energy}"
+    except (ValueError, KeyError, TypeError, json.JSONDecodeError) as exc:
+        return f"invalid or malformed JSON decision ({exc})"
+    return None
+
 class TaskAgent(AgentSystem):
     def act(self, prompt, image_paths=None, max_tokens=16384):
         """Expose the common Agent interface while retaining ``forward``."""
