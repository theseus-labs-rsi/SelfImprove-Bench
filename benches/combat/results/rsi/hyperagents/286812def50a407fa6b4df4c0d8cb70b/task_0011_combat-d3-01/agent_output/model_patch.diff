+import json
+import re
+
 from agent.base_agent import AgentSystem
 from agent.llm_withtools import chat_with_agent
 
+
+def _extract_observation(instruction):
+    """Read only the structured current-state block, when provided."""
+    marker = "## Current stage state"
+    text = instruction.split(marker, 1)[-1] if marker in instruction else instruction
+    match = re.search(r"```json\s*(\{.*?\})\s*```", text, re.DOTALL)
+    if not match:
+        return None
+    try:
+        return json.loads(match.group(1))
+    except json.JSONDecodeError:
+        return None
+
+
+def _decision_error(decision, observation):
+    """Return a legality error for common structured action mistakes."""
+    if not observation or observation.get("decision_type") != "combat":
+        return None
+    combat = observation.get("combat", {})
+    cards = observation.get("card_catalog", {})
+    energy = observation.get("player_state", {}).get("energy_per_turn")
+    draws = {d.get("turn"): d for d in combat.get("draws", [])}
+    for entry in decision.get("turns", []):
+        turn = entry.get("turn")
+        draw = draws.get(turn)
+        if not draw:
+            return f"turn {turn} is not in the supplied combat horizon"
+        hand = list(draw.get("hand", []))
+        spent = 0
+        for card in entry.get("play", []):
+            if card not in hand:
+                return f"turn {turn}: {card!r} is not an unused card in that hand"
+            hand.remove(card)
+            spent += cards.get(card, {}).get("cost", 0)
+        if energy is not None and spent > energy:
+            return f"turn {turn}: selected cards cost {spent}, exceeding energy {energy}"
+    return None
+
 class TaskAgent(AgentSystem):
     def act(self, prompt, image_paths=None, max_tokens=16384):
         """Expose the common Agent interface while retaining ``forward``."""
