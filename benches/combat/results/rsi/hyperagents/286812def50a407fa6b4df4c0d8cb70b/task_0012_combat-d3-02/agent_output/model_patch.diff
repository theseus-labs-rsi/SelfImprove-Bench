+def _combat_incomplete(decision, observation):
+    """Catch the common failure where a plan stops with a live enemy."""
+    if not observation or observation.get("decision_type") != "combat":
+        return None
+    combat = observation.get("combat", {})
+    enemy = combat.get("enemy", {})
+    hp = enemy.get("max_hp")
+    if hp is None:
+        return None
+    enemy_block = 0
+    cards = observation.get("card_catalog", {})
+    by_turn = {item.get("turn"): item.get("play", []) for item in decision.get("turns", [])}
+    draws = {item.get("turn"): item for item in combat.get("draws", [])}
+    intents = {item.get("turn"): item.get("enemy_intent", {}) for item in combat.get("draws", [])}
+    last = max(by_turn, default=0)
+    # Replaying only to the last emitted turn is enough to detect premature stop.
+    for turn in range(1, last + 1):
+        player_block = 0
+        for card in by_turn.get(turn, []):
+            stats = cards.get(card, {})
+            damage = stats.get("damage", 0)
+            absorbed = min(enemy_block, damage)
+            enemy_block -= absorbed
+            hp -= damage - absorbed
+            player_block += stats.get("block", 0)
+            if hp <= 0:
+                return None
+        intent = intents.get(turn, {})
+        if hp > 0 and intent.get("type") == "guard":
+            enemy_block = intent.get("value", 0)
+        elif hp > 0 and intent.get("type") == "attack":
+            # Player block resets each turn; this is only needed for the audit.
+            pass
+    if hp > 0 and last < max(draws, default=0):
+        return f"the emitted combat plan ends with enemy HP {hp}; append legal turns through the first lethal turn"
+    return None
+
