+def _combat_survival_error(decision, observation):
+    """Reject combat plans that demonstrably kill the player before the plan ends."""
+    if not observation or observation.get("decision_type") != "combat":
+        return None
+    combat = observation.get("combat", {})
+    hp = observation.get("player_state", {}).get("hp")
+    if hp is None:
+        return None
+    cards = observation.get("card_catalog", {})
+    draws = {item.get("turn"): item for item in combat.get("draws", [])}
+    by_turn = {item.get("turn"): item.get("play", []) for item in decision.get("turns", [])}
+    enemy_hp = combat.get("enemy", {}).get("max_hp")
+    enemy_block = 0
+    for turn in range(1, max(draws, default=0) + 1):
+        player_block = 0
+        for card in by_turn.get(turn, []):
+            stats = cards.get(card, {})
+            damage = stats.get("damage", 0)
+            absorbed = min(enemy_block, damage)
+            enemy_block -= absorbed
+            enemy_hp -= damage - absorbed
+            player_block += stats.get("block", 0)
+            if enemy_hp <= 0:
+                return None
+        intent = draws[turn].get("enemy_intent", {})
+        if intent.get("type") == "guard":
+            enemy_block = intent.get("value", 0)
+        elif intent.get("type") == "attack":
+            hp -= max(0, intent.get("value", 0) - player_block)
+            if hp <= 0:
+                return f"the plan reaches 0 HP on turn {turn}; use a legal block or faster lethal line"
+    return None
+
+
 class TaskAgent(AgentSystem):
