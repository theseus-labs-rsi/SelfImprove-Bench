ld_per_harvest\": 2,\n      \"fruit_price\": 40\n    },\n    \"carrot\": {\n      \"id\": \"carrot\",\n      \"name\": \"胡萝卜\",\n      \"seed_price\": 20,\n      \"maturity_days\": 3,\n      \"yield_per_harvest\": 1,\n      \"fruit_price\": 35\n    },\n    \"cauliflower\": {\n      \"id\": \"cauliflower\",\n      \"name\": \"花椰菜\",\n      \"seed_price\": 80,\n      \"maturity_days\": 12,\n      \"yield_per_harvest\": 1,\n      \"fruit_price\": 175\n    },\n    \"coffee_bean\": {\n      \"id\": \"coffee_bean\",\n      \"name\": \"咖啡豆\",\n      \"seed_price\": 450,\n      \"maturity_days\": 10,\n      \"yield_per_harvest\": 20,\n      \"fruit_price\": 30\n    },\n    \"garlic\": {\n      \"id\": \"garlic\",\n      \"name\": \"蒜\",\n      \"seed_price\": 40,\n      \"maturity_days\": 4,\n      \"yield_per_harvest\": 1,\n      \"fruit_price\": 60\n    },\n    \"green_bean\": {\n      \"id\": \"green_bean\",\n      \"name\": \"青豆\",\n      \"seed_price\": 200,\n      \"maturity_days\": 10,\n      \"yield_per_harvest\": 8,\n      \"fruit_price\": 40\n    },\n    \"kale\": {\n      \"id\": \"kale\",\n      \"name\": \"甘蓝菜\",\n      \"seed_price\": 70,\n      \"maturity_days\": 6,\n      \"yield_per_harvest\": 1,\n      \"fruit_price\": 110\n    },\n    \"potato\": {\n      \"id\": \"potato\",\n      \"name\": \"土豆\",\n      \"seed_price\": 50,\n      \"maturity_days\": 6,\n      \"yield_per_harvest\": 5,\n      \"fruit_price\": 20\n    },\n    \"rhubarb\": {\n      \"id\": \"rhubarb\",\n      \"name\": \"大黄\",\n      \"seed_price\": 100,\n      \"maturity_days\": 13,\n      \"yield_per_harvest\": 1,\n      \"fruit_price\": 220\n    },\n    \"strawberry\": {\n      \"id\": \"strawberry\",\n      \"name\": \"草莓\",\n      \"seed_price\": 300,\n      \"maturity_days\": 8,\n      \"yield_per_harvest\": 5,\n      \"fruit_price\": 100\n    },\n    \"tulip\": {\n      \"id\": \"tulip\",\n      \"name\": \"郁金香\",\n      \"seed_price\": 20,\n      \"maturity_days\": 6,\n      \"yield_per_harvest\": 2,\n      \"fruit_price\": 30\n    },\n    \"unmilled_rice\": {\n      \"id\": \"unmilled_rice\",\n      \"name\": \"未碾米\",\n      \"seed_price\": 40,\n      \"maturity_days\": 8,\n      \"yield_per_harvest\": 10,\n      \"fruit_price\": 10\n    }\n  },\n  \"rules\": {\n    \"day_numbering\": \"1-based\",\n    \"daily_operation_order\": [\n      \"buy_seeds\",\n      \"plant\",\n      \"harvest\",\n      \"sell\"\n    ],\n    \"harvest_day\": \"plant_day + maturity_days\",\n    \"unsold_fruit_has_no_value\": true\n  }\n}\n```\n\nThis is a non-interactive API call. Do not inspect files, use tools, or write explanations. Compute the plan directly and return only the plan JSON object as specified above.\n",
