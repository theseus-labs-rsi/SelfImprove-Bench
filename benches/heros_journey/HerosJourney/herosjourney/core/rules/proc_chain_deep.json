{
  "_note": "P-Chain-Deep: each seed samples identifiable action, count, and two-block order logic.",
  "input_category": "entity.npc",
  "input_meta": {
    "name": ["name_pools.first", "name_pools.last"],
    "repeat_name": ["name_pools.repeat_first", "name_pools.repeat_last"],
    "properties": {"location": "locations"}
  },
  "inputs": [
    {"name": "class", "n_values": 4, "pool": "attributes.class", "nonce_pool": "attribute_slots.0", "nonce_label": "attribute_labels.0"},
    {"name": "role", "n_values": 4, "pool": "attributes.role", "nonce_pool": "attribute_slots.1", "nonce_label": "attribute_labels.1"},
    {"name": "rank", "n_values": 4, "pool": "attributes.class", "nonce_pool": "attribute_slots.2", "nonce_label": "attribute_labels.2"}
  ],
  "output": {
    "type": "process",
    "seeded_logic": {"family": "ordered_extensions_v1", "block_count": 2},
    "outputs": [
      {"name": "action_type", "n_values": 2},
      {"name": "ordering", "n_values": 4},
      {"name": "count", "n_values": 6}
    ],
    "functions": [
      {"name": "f_class_action", "input": "class", "output": "action_type", "map": [0, 1, 1, 0]},
      {"name": "f_role_order", "input": "role", "output": "ordering", "map": [0, 2, 1, 3]},
      {"name": "f_rank_count", "input": "rank", "output": "count", "map": [2, 4, 3, 5]}
    ],
    "composition": {"fn": "independent"},
    "extra_pools": {
      "activity.ritual": {"name_keys": ["rituals"]},
      "activity.potion": {"name_keys": ["potions"]},
      "activity.ritual_pre": {"name_keys": ["rituals"]},
      "activity.potion_pre": {"name_keys": ["potions"]}
    },
    "extension": {
      "count": {"from_dim": "count"},
      "action": {"from_dim": "action_type", "values": ["perform", "drink"]},
      "pool": {"by_action": {"perform": "activity.ritual_pre", "drink": "activity.potion_pre"}},
      "position": {
        "from_dim": "ordering",
        "values": [
          {"before": "buy_0"},
          {"before": "perform_prep"},
          {"before": "drink_prep"},
          {"before": "go_entity"}
        ]
      },
      "is_hidden": true
    }
  }
}
