# ============================================================================
# Agentic-Harness-Engineering environment variable template
# Usage: cp .env.example .env and fill in real values. .env is already in .gitignore.
# ============================================================================

# ---- Primary LLM (required)---------------------------------------------------------
# The top-level llm: and code_agent_patch in configs/base.yaml reference ${LLM_*};
# evolve.py derives LLM_API_KEY / LLM_BASE_URL / LLM_MODEL from them and injects them into
# the ${env.LLM_*} of evolve_agent.yaml. Default model: nex-agi/deepseek-v3.1-nex-1.
LLM_API_KEY="your_primary_llm_api_key"
LLM_BASE_URL="https://api.example.com/v1"

# ---- Dedicated LLM for the ADB debugger (referenced by configs/base.yaml agent_debugger.llm)------
# If unset, ADB uses the same LLM_*; set it separately to use a reasoning model such as gpt-5.4.
ADB_LLM_API_KEY="your_adb_llm_api_key"
ADB_LLM_BASE_URL="https://api.example.com/v1"

# ---- Experiment-specific LLM (configs/experiments/exp-simple-code-gpt54.yaml)-----
GPT54_LLM_API_KEY="your_gpt54_llm_api_key"
GPT54_LLM_BASE_URL="https://api.example.com/v1"

# ---- E2B sandbox (required)-------------------------------------------------------
E2B_API_KEY="your_e2b_api_key"
# Fill in when using a self-hosted E2B cluster; can be left empty for the cloud version
E2B_API_URL="https://your-e2b-host.example.com"
E2B_DOMAIN="your-e2b-host.example.com"
E2B_SANDBOX_TIMEOUT=3600
# E2B_MAX_RETRIES=5
# E2B_RETRY_MAX_WAIT=900

# ---- GitHub access (required)---------------------------------------------------
GITHUB_TOKEN="your_github_pat"

# ---- Web search (used by evolve_agent's web_search tool)-----------------------
SERPER_API_KEY="your_serper_api_key"

# ---- HTML parsing (optional enhancement for evolve_agent's web_fetch tool)------------------
# Enabled only when all three are set; missing any one falls back to plain fetching
# BP_HTML_PARSER_URL=""
# BP_HTML_PARSER_API_KEY=""
# BP_HTML_PARSER_SECRET=""

# ---- Langfuse observability (optional)---------------------------------------------
# LANGFUSE_SECRET_KEY=""
# LANGFUSE_PUBLIC_KEY=""
# LANGFUSE_HOST=""
# LANGFUSE_BASE_URL=""

# ---- Feishu (Lark) notification (optional)------------------------------------------------------
# configs/base.yaml notify.feishu_webhook references ${FEISHU_WEBHOOK}
# FEISHU_WEBHOOK="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxx"
